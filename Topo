#include <stdio.h>

int a[10][10], indegree[10], flag[10], n;

void topo()
{
    int i, j, k;

    for (k = 0; k < n; k++)
    {
        for (i = 0; i < n; i++)
        {
            if (indegree[i] == 0 && flag[i] == 0)
            {
                printf("%d\t", i + 1);
                flag[i] = 1;

                for (j = 0; j < n; j++)
                {
                    if (a[i][j] == 1)
                        indegree[j]--;
                }
            }
        }
    }
}

int main()
{
    int i, j;

    printf("ENTER THE NUMBER OF NODES\n");
    scanf("%d", &n);

    printf("ENTER THE ADJACENCY MATRIX\n");
    for (i = 0; i < n; i++)
    {
        for (j = 0; j < n; j++)
        {
            scanf("%d", &a[i][j]);
        }
    }

    // Calculate indegree
    for (j = 0; j < n; j++)
    {
        indegree[j] = 0;
        for (i = 0; i < n; i++)
        {
            indegree[j] += a[i][j];
        }
    }

    printf("THE TOPOLOGICAL SEQUENCE IS\n");
    topo();

    return 0;
}
